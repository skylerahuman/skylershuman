{
  "name": "skylershuman-com",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.9.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "quality": "biome ci . && node scripts/comments.mjs && node scripts/budget.mjs",
