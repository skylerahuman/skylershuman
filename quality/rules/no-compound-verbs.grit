engine biome(1.0)
language js(typescript, jsx)

or {
	JsFunctionDeclaration(id=$name) as $fn,
	JsMethodClassMember(name=$name) as $fn,
	JsVariableDeclarator(id=$name) as $fn where {
		$fn <: r"\w+\s*=\s*(?:async\s*)?(?:function\b[\s\S]*|\([^()]*\)\s*=>[\s\S]*)"
	}
} where {
	$name <: r".*[a-z]And[A-Z].*",
	register_diagnostic(span=$name, message="Two verbs in one name. Split it into two functions and compose them at the call site.", severity="error")
}
